{
  "manifest_version": 3,
  "name": "Dota2-KickGSI",
  "version": "1.0",
  "description": "Automatically opens and resolves native Kick predictions based on Dota 2 game state.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://dashboard.kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
